# 仓库统一 LF：覆盖系统级 core.autocrlf=true（Git for Windows 默认），
# 避免 "LF will be replaced by CRLF" 警告与幽灵修改。
* text=auto eol=lf

# 明确按文本处理、且在各平台都必须是 LF 的类型
*.md    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.cpp   text eol=lf
*.cmake text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.sh    text eol=lf
*.pya   text eol=lf
*.cpya  text eol=lf
CMakeLists.txt text eol=lf
.gitattributes text eol=lf

# 二进制资源保持原样
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.o binary
*.so binary
*.exe binary
*.dll binary
*.pyd binary
*.zip binary

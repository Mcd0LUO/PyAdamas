# P1 收尾：cimport 窄/无符号 C 类型 → 定宽 TyKind（char=i8、short=i16、
# uchar=u8、ushort=u16、uint64/ulong=u64）。边界按宽度符号/零扩展。
cmodule("cfixedint")
link("tests/run/cfixedint.c")

CMAX: char = 127
UMAX: uchar = 255
U64MAX: uint64 = 18446744073709551615

@extern("fi_char_id")
def char_id(x: char) -> char: pass
@extern("fi_char_neg")
def char_neg() -> char: pass
@extern("fi_short_id")
def short_id(x: short) -> short: pass
@extern("fi_short_min")
def short_min() -> short: pass
@extern("fi_uchar_id")
def uchar_id(x: uchar) -> uchar: pass
@extern("fi_uchar_max")
def uchar_max() -> uchar: pass
@extern("fi_ushort_id")
def ushort_id(x: ushort) -> ushort: pass
@extern("fi_ushort_max")
def ushort_max() -> ushort: pass
@extern("fi_u64_id")
def u64_id(x: uint64) -> uint64: pass
@extern("fi_u64_max")
def u64_max() -> uint64: pass
@extern("fi_u64_add")
def u64_add(a: uint64, b: uint64) -> uint64: pass

char_global: char = extern_var("fi_char_global")
ushort_global: ushort = extern_var("fi_ushort_global")
u64_global: uint64 = extern_var("fi_u64_global")

@extern("fi_char_arr_ptr")
def char_arr() -> ptr[char]: pass
@extern("fi_u64_arr_ptr")
def u64_arr() -> ptr[uint64]: pass

class FiMixed:
    c: char
    s: short
    uc: uchar
    us: ushort
    u64: uint64

@extern("fi_struct_make")
def struct_make(c: char, s: short, uc: uchar, us: ushort, u64: uint64) -> FiMixed: pass
@extern("fi_cb_call")
def cb_call(cb: Callable[[char, short, uchar, ushort, uint64], uint64]) -> uint64: pass

# 按值结构体 ABI 的 shim：SSE chunk 与 >16 字节 MEMORY 类。
cmodule("cstructabi")
link("tests/run/structabi.c")

class pair:
    a: float
    b: float

class triple:
    a: int
    b: int
    c: int

def pair_add(p: pair, q: pair) -> pair: pass
def triple_sum(p: triple) -> triple: pass
def triple_mix(x: int, p: triple, y: int) -> int: pass

# 不同宽度的全局变量：读取与写回都要按声明宽度进行。
cvar_i: int
cvar_u: uint32
cvar_f: float
cvar_b: bool

def ptr_i32() -> ptr[int32]: pass
def ptr_u32() -> ptr[uint32]: pass

# C 回调参数：fn(...) -> ret 的签名只允许标量/指针。
def cb_apply(a: int, b: int, fn: Callable[[int, int], int]) -> int: pass
def cb_apply_f(x: float, fn: Callable[[float], float]) -> float: pass
def cb_apply_i32(a: int32, b: int32, fn: Callable[[int32, int32], int32]) -> int32: pass
def cb_fold(n: int, fn: Callable[[int, int], int], init: int) -> int: pass
def cb_apply_b(x: bool, fn: Callable[[bool], bool]) -> bool: pass

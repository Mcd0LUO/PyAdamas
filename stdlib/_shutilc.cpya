# shutil C 绑定：stat/utime/symlink/readlink（os 原生面没有这些）。
# 错误归一化成负码（见 shutil_glue.c），Python 侧映射异常类型。
cmodule("_shutilc")
link("shutil_glue.c")

@extern("pa_shutil_stat")
def stat(path: str, follow: int, out: ptr[int]) -> int: pass
@extern("pa_shutil_utime")
def utime(path: str, at_sec: int, at_nsec: int, mt_sec: int, mt_nsec: int, follow: int) -> int: pass
@extern("pa_shutil_readlink")
def readlink(path: str, buf: ptr, cap: int) -> int: pass
@extern("pa_shutil_symlink")
def symlink(target: str, linkpath: str) -> int: pass
@extern("pa_shutil_strerror")
def strerror(code: int) -> str: pass

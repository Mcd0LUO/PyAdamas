cmodule("cblas")
link("openblas")

ROW_MAJOR: int32 = 101
NO_TRANS: int32 = 111
TRANS: int32 = 112

@extern("cblas_dgemm")
def dgemm(layout: int32, trans_a: int32, trans_b: int32, m: int32, n: int32, k: int32, alpha: float, a: ptr[float], lda: int32, b: ptr[float], ldb: int32, beta: float, c: ptr[float], ldc: int32) -> None: pass
@extern("cblas_dgemv")
def dgemv(layout: int32, trans_a: int32, m: int32, n: int32, alpha: float, a: ptr[float], lda: int32, x: ptr[float], incx: int32, beta: float, y: ptr[float], incy: int32) -> None: pass
@extern("cblas_ddot")
def ddot(n: int32, x: ptr[float], incx: int32, y: ptr[float], incy: int32) -> float: pass
@extern("cblas_dnrm2")
def dnrm2(n: int32, x: ptr[float], incx: int32) -> float: pass
@extern("cblas_daxpy")
def daxpy(n: int32, alpha: float, x: ptr[float], incx: int32, y: ptr[float], incy: int32) -> None: pass
@extern("cblas_dscal")
def dscal(n: int32, alpha: float, x: ptr[float], incx: int32) -> None: pass

# stdlib/sigs/os.pysig —— os 模块的声明式签名（P0 第 5 批）
#
# 只声明「模块级函数 + 标量常量」。保留在 C++ 的：
# - environ（builtin_value 返回 dict，pysig 不支持容器常量）
# - walk（返回 list[tuple]，shape 复杂）
# - os.path.*（已迁到 stdlib/sigs/os/path.pysig，属于另一个模块）
# makedirs 的 exist_ok 手工装配在 lower_import_native.cpp（§6.4），签名仍在此声明。
"""os 模块的 native 签名（17 函数 + 6 标量常量）。"""

# 标量常量（POSIX 口径）。
F_OK: int = 0
X_OK: int = 1
W_OK: int = 2
R_OK: int = 4
sep: str = "/"
linesep: str = "\n"
# POSIX 口径的路径常量。altsep 在 POSIX 上就是 None（CPython 同口径），
# 声明成 None 才精确：拿它当 str 用会立刻报错，而不是静默拿到空串。
name: str = "posix"
curdir: str = "."
pardir: str = ".."
altsep: None = None
pathsep: str = ":"
extsep: str = "."
devnull: str = "/dev/null"

# 无参函数。
def getcwd() -> str: pass
def cpu_count() -> int: pass
def getpid() -> int: pass
def getuid() -> int: pass
def geteuid() -> int: pass
def getppid() -> int: pass

# 单参 str -> None。
def mkdir(path: str) -> None: pass
def rmdir(path: str) -> None: pass
def remove(path: str) -> None: pass
# unlink 的运行期入口与 remove 共用 pa_os_remove。
@native("pa_os_remove")
def unlink(path: str) -> None: pass
def chdir(path: str) -> None: pass
def listdir(path: str) -> list[str]: pass
# getenv(name, default="")：CPython 缺失返回 None，PA 用空串默认值。
def getenv(name: str, default: str = "") -> str: pass

# 双参函数。
def rename(src: str, dst: str) -> None: pass
def chmod(path: str, mode: int) -> None: pass
def access(path: str, mode: int) -> bool: pass
def makedirs(name: str, exist_ok: bool = False) -> None: pass
def system(command: str) -> int: pass

# close(fd) —— 运行期符号 pa_os_close。
def close(fd: int) -> None: pass

# 文件描述符面（0.518）：符号按约定 pa_os_<name>。O_* 常量值与宿主 C 宏一致
# （rt_os.c 里有 _Static_assert 在编译期校验）。
O_RDONLY: int = 0
O_WRONLY: int = 1
O_RDWR: int = 2
O_CREAT: int = 64
O_EXCL: int = 128
O_TRUNC: int = 512
O_APPEND: int = 1024
O_NONBLOCK: int = 2048
def open(path: str, flags: int, mode: int = 511) -> int: pass
def read(fd: int, n: int) -> bytes: pass
def write(fd: int, data: bytes) -> int: pass
def lseek(fd: int, pos: int, whence: int) -> int: pass
def dup(fd: int) -> int: pass
def fdopen(fd: int, mode: str = "r") -> file: pass

# os.stat / lstat（0.518 C 部分）：返回内建记录对象 os.stat_result，10 个整数属性。
def stat(path: str) -> stat_result: pass
def lstat(path: str) -> stat_result: pass

# 随机字节（bytes，不是 str）：读 /dev/urandom。
def urandom(n: int) -> bytes: pass
# strerror(code)：errno → 文本。
def strerror(code: int) -> str: pass
# replace 与 rename 同语义（POSIX 下 rename(2) 本来就会静默覆盖）。
@native("pa_os_rename")
def replace(src: str, dst: str) -> None: pass

# stdlib/sigs/random.pysig —— random 模块的声明式签名（P0 第 5 批）
#
# 只声明模块级函数。Random 类及其 r.* 方法（pa_random_* 一族）没有 class
# 声明语法，保留在 C++；choice/sample/choices 的参数装配在
# lower_import_native.cpp 的 lower_random_extra（§6.4），签名不影响那些分支。
#
# 两处曾经「声明不了」的能力现在都有通道：
#   * choice/sample/choices 的返回类型按实参特化 → @ret_specialized（ret_known=false）；
#   * seed 的 INT64_MIN 哨兵默认值 → 一元负号 + u64 字面量折叠成 INT64_MIN。
"""random 模块的 native 签名（17 个模块级函数）。"""

# 全局 PRNG 的函数走 pa_random_g* 入口（装饰器覆盖约定符号）。
@native("pa_random_gnext")
def random() -> float: pass
@native("pa_random_grandint")
def randint(a: int, b: int) -> int: pass
@native("pa_random_guniform")
def uniform(a: float, b: float) -> float: pass
@native("pa_random_gshuffle")
def shuffle(x: list[object]) -> None: pass

# 返回类型由调用点按实参特化：@ret_specialized 让加载器产出 FuncInfo
# {ret=unknown, ret_known=false}，与硬编码路径逐字段一致，调用点代码生成不变。
@native("pa_random_gchoice")
@ret_specialized
def choice(seq: object) -> object: pass
@native("pa_random_sample")
@ret_specialized
def sample(seq: object, k: int) -> object: pass
@native("pa_random_choices")
@ret_specialized
def choices(seq: object, k: int) -> object: pass

# seed 的默认值是 INT64_MIN 哨兵（-2^63）。
@native("pa_random_gseed")
def seed(a: int = -9223372036854775808) -> None: pass

# 其余走约定符号 pa_random_<name>。
def randrange(*args: int) -> int: pass
def getrandbits(k: int) -> int: pass
def gauss(mu: float, sigma: float) -> float: pass

# 分布函数（0.515）：逐行照抄 CPython 3.14 Lib/random.py 的公式，与 CPython
# 同种子逐字节一致（random() 序列本身已逐位相同）。
@native("pa_random_gnormalvariate")
def normalvariate(mu: float = 0.0, sigma: float = 1.0) -> float: pass
@native("pa_random_ggammavariate")
def gammavariate(alpha: float, beta: float) -> float: pass
@native("pa_random_gbetavariate")
def betavariate(alpha: float, beta: float) -> float: pass
@native("pa_random_glognormvariate")
def lognormvariate(mu: float, sigma: float) -> float: pass
@native("pa_random_gparetovariate")
def paretovariate(alpha: float) -> float: pass
@native("pa_random_gweibullvariate")
def weibullvariate(alpha: float, beta: float) -> float: pass
def expovariate(lambd: float) -> float: pass
def triangular(low: float, high: float = 0.0, mode: float = 0.0) -> float: pass

# ── 原生类：class = 原生类（body 只有方法；__init__ 是构造器）────────────
# 方法首参 self 不参与签名；@native 覆盖运行期符号（实例方法用 pa_random_*
# 而非模块级 pa_random_g*）；@ret_specialized 表示返回类型按调用点特化。
class Random:
    @native("pa_random_new")
    def __init__(self, a: int = -9223372036854775808) -> None: pass

    @native("pa_random_next")
    def random(self) -> float: pass

    @native("pa_random_seed")
    def seed(self, a: int = -9223372036854775808) -> None: pass

    @native("pa_random_randint")
    def randint(self, a: int, b: int) -> int: pass

    @native("pa_random_uniform")
    def uniform(self, a: float, b: float) -> float: pass

    @native("pa_random_choice")
    @ret_specialized
    def choice(self, seq: object) -> object: pass

    @native("pa_random_shuffle")
    def shuffle(self, x: list[object]) -> None: pass
# randbytes(n) -> bytes：与 CPython 同一字消耗（同一个种子逐字节一致）。
def randbytes(n: int) -> bytes: pass

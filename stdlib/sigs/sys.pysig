# stdlib/sigs/sys.pysig —— sys 模块的声明式签名（P0 第 4 批）
#
# 只有「纯数据」部分迁到这里：标量常量 + 走通用 native_fn 的函数。
# argv/executable/stdin/stdout/stderr 是运行期调用（builtin_value 里的
# call_runtime），exc_info 的返回类型含 ClassObj（pysig 语法表达不了），
# 这三项保留在 C++。格式见 docs/native-stdlib-cookbook.md。
"""sys 模块的 native 签名（1 个标量常量 + 1 个函数）。"""

# maxsize = INT64_MAX，与 CPython 3.14 Linux 一致。
maxsize: int = 9223372036854775807

# 平台与版本常量。值按**目标平台**（Linux x86-64）与项目对标的 CPython 3.14.4
# 固定：pyadamas 没有运行期解释器身份，这些值只能是编译期常量。version 的
# 后缀（build 日期/编译器串）不复制，写成 "3.14.4 (pyadamas)"；hexversion 与
# version_info 同口径（(3<<24)|(14<<16)|(4<<8)|0xF0）。
# 注意：stdlib/platform.py 的 python_version() 仍是旧值 "3.12.0"（既有不一致，
# 本轮不动，见 docs/frontend-gaps.md）。
platform: str = "linux"
# api_version：CPython 3.14 的 C API 版本号（3.14.4 实测 1013）。
api_version: int = 1013
# pyadamas 从不写 .pyc（编译产物是 IR），与 CPython 默认值 False 一致。
dont_write_bytecode: bool = False
version: str = "3.14.4 (pyadamas)"
byteorder: str = "little"
maxunicode: int = 1114111
hexversion: int = 51250416

# sys.exit(code) → None；运行期符号 pa_sys_exit 由约定推导。
def exit(code: int) -> None: pass

# sys.intern(s)：返回驻留后的字符串（pa 没有驻留表，返回同一份）。
def intern(s: str) -> str: pass

# 递归上限：pyadamas 没有运行期递归限制，这两个函数只保存/查询一个值
# （默认 1000，与 CPython 一致；set 校验 n >= 1），让依赖它的代码行为一致。
def getrecursionlimit() -> int: pass
def setrecursionlimit(limit: int) -> int: pass

# 成员级编译期拒绝（@reject）：成员**存在但不可用**，使用时直接报原因。
# getrefcount：运行期不暴露引用计数（RC 头是内部布局），给假数字比不给更糟。
@reject("sys.getrefcount is not available: pyadamas does not expose reference counts")
def getrefcount(obj: object) -> int: pass

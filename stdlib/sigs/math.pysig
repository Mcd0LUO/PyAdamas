# stdlib/sigs/math.pysig —— math 模块的声明式签名（P0 第 3 批）
#
# 模块名 = 相对 stdlib/sigs/ 的路径：math.pysig → 模块 math。
# 运行期符号按约定推导：math.sqrt → pa_math_sqrt。
# 格式规格与操作手册见 docs/native-stdlib-cookbook.md。
"""math 模块的 native 签名（57 个函数 + 3 个可声明常量）。"""

# ── 常量 ──
# inf/nan 没有 Python 字面量写法：用 float("inf") / float("nan") 这种合法
# 调用形式作常量初值（pydecl 只认这一小组白名单）。这样声明与实际值一致，
# 不必再在 builtin_value 里特判。
pi: float = 3.14159265358979323846
e: float = 2.71828182845904523536
tau: float = 6.28318530717958647692
inf: float = float("inf")
nan: float = float("nan")

# ── 单参数 float → float ──
def sqrt(x: float) -> float: pass
def fabs(x: float) -> float: pass
def sin(x: float) -> float: pass
def cos(x: float) -> float: pass
def tan(x: float) -> float: pass
def log(x: float) -> float: pass
def log2(x: float) -> float: pass
def log10(x: float) -> float: pass
def exp(x: float) -> float: pass
def degrees(x: float) -> float: pass
def radians(x: float) -> float: pass
def acos(x: float) -> float: pass
def asin(x: float) -> float: pass
def atan(x: float) -> float: pass
def acosh(x: float) -> float: pass
def asinh(x: float) -> float: pass
def atanh(x: float) -> float: pass
def cbrt(x: float) -> float: pass
def cosh(x: float) -> float: pass
def sinh(x: float) -> float: pass
def tanh(x: float) -> float: pass
def exp2(x: float) -> float: pass
def expm1(x: float) -> float: pass
def log1p(x: float) -> float: pass
def erf(x: float) -> float: pass
def erfc(x: float) -> float: pass
def gamma(x: float) -> float: pass
def lgamma(x: float) -> float: pass
def ulp(x: float) -> float: pass

# ── 单参数 float → int ──
def floor(x: float) -> int: pass
def ceil(x: float) -> int: pass
def trunc(x: float) -> int: pass

# ── 单参数 float → bool ──
def isnan(x: float) -> bool: pass
def isinf(x: float) -> bool: pass
def isfinite(x: float) -> bool: pass

# ── 双参数 float → float ──
def pow(x: float, y: float) -> float: pass
def fmod(x: float, y: float) -> float: pass
def atan2(y: float, x: float) -> float: pass
def hypot(x: float, y: float) -> float: pass
def copysign(x: float, y: float) -> float: pass
def nextafter(x: float, y: float) -> float: pass
def remainder(x: float, y: float) -> float: pass

# ── 整数函数 ──
def factorial(n: int) -> int: pass
def isqrt(n: int) -> int: pass
def gcd(a: int, b: int) -> int: pass
def lcm(a: int, b: int) -> int: pass
def comb(n: int, k: int) -> int: pass
def perm(n: int, k: int) -> int: pass

# ── 容器 / 混合参数 ──
def fsum(xs: list[float]) -> float: pass
def ldexp(x: float, i: int) -> float: pass
def fma(x: float, y: float, z: float) -> float: pass
def isclose(a: float, b: float) -> bool: pass
def frexp(x: float) -> tuple[float, int]: pass
def modf(x: float) -> tuple[float, float]: pass
def prod(xs: list[int]) -> int: pass
def sumprod(a: list[int], b: list[int]) -> int: pass
def dist(p: list[float], q: list[float]) -> float: pass

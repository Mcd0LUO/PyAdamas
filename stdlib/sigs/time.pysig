# stdlib/sigs/time.pysig —— time 模块的声明式签名（P0）
#
# 这是 **Python 语法**的 stub：函数体只有 pass，没有实现。编译器把声明里的
# 函数直接当 native（运行期符号按 pa_<模块>_<名字> 推导），所以新增 API 只需
# 改这个文件，不用改任何 C++。格式与字段含义见 docs/native-stdlib-cookbook.md。
"""time 模块的 native 签名（模块名 = 相对 stdlib/sigs/ 的路径：time）。"""


def time() -> float: pass
def monotonic() -> float: pass
def perf_counter() -> float: pass
def sleep(secs: float) -> None: pass

# localtime/gmtime 的可选参数用 -1e300 当「取当前时间」的哨兵（CPython 无此
# 约定，见 runtime/rt_time.c 的注释）；返回 9 元 int 元组（struct_time 的
# 下标形态）。运行期符号：pa_time_localtime / pa_time_gmtime。
def localtime(secs: float = -1e300) -> struct_time: pass
def gmtime(secs: float = -1e300) -> struct_time: pass

# strftime 的第二实参可以是 9 元组/9 元列表，参数装配在
# lower_import_native.cpp 里手工做（声明只负责类型检查放行）。
def strftime(*args: unknown) -> str: pass

# mktime 接受 9 元组或 9 元列表，所以形参是 unknown（list 按 CPython 口径不接受）。
def mktime(t: tuple[int, ...]) -> float: pass
def strptime(s: str, fmt: str) -> struct_time: pass

# 常量表（CPython 下同名的 int 常量）。这两个值是 Linux 的 <time.h> 口径，
# 与 CPython 的 time.CLOCK_MONOTONIC / time.CLOCK_REALTIME 一致。
# 纯数据新增：加这两行之前 time 模块没有它们，加完立刻可用，零 C++。
CLOCK_REALTIME: int = 0
CLOCK_MONOTONIC: int = 1

# 演示：纯数据新增一个 CPython 真常量（Linux <time.h> 口径 = 2）
CLOCK_PROCESS_CPUTIME_ID: int = 2
# 纳秒时钟（整数）与进程 CPU 时间。perf_counter 与 monotonic 同源。
def time_ns() -> int: pass
def monotonic_ns() -> int: pass
def perf_counter_ns() -> int: pass
def process_time() -> float: pass

# stdlib/sigs/pathlib.pysig —— pathlib 模块的声明式签名（原生类批次）
#
# Path 的构造器与方法签名。构造器降级（lower_import_misc.cpp）、参数装配与
# mkdir 关键字白名单（lower_method_native.cpp）保留在 C++；`/` 运算符在
# typecheck_expr.cpp 保留。unlink/rmdir 没有 pa_path_* 入口，仍留在 method_call。
# 返回 Path / list[Path] 的方法用 object 占位，具体返回类型在
# typecheck_call_method.cpp 按接收者特化。
"""pathlib 模块的 native 签名（Path 类）。"""

class Path:
    @native("pa_path_new")
    def __init__(self, path: str) -> None: pass

    @native("pa_path_exists")
    def exists(self) -> bool: pass
    @native("pa_path_is_file")
    def is_file(self) -> bool: pass
    @native("pa_path_is_dir")
    def is_dir(self) -> bool: pass
    @native("pa_path_is_absolute")
    def is_absolute(self) -> bool: pass

    @native("pa_path_read_text")
    def read_text(self) -> str: pass
    @native("pa_path_write_text")
    def write_text(self, data: str) -> int: pass
    @native("pa_path_read_bytes")
    def read_bytes(self) -> bytes: pass
    @native("pa_path_write_bytes")
    def write_bytes(self, data: bytes) -> int: pass

    @native("pa_path_iterdir")
    def iterdir(self) -> object: pass
    @native("pa_path_glob")
    def glob(self, pattern: str) -> object: pass

    @native("pa_path_join")
    def joinpath(self, other: object) -> object: pass
    @native("pa_path_relative_to")
    def relative_to(self, other: object) -> object: pass
    @native("pa_path_with_suffix")
    def with_suffix(self, suffix: str) -> object: pass
    @native("pa_path_resolve")
    def resolve(self) -> object: pass
    @native("pa_path_absolute")
    def absolute(self) -> object: pass

    @native("pa_path_touch")
    def touch(self) -> None: pass
